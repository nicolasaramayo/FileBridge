<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FileBridge.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FileBridge.UI"
    FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Devices" Icon="devices.png">
            <ShellContent Route="devices" ContentTemplate="{DataTemplate local:DeviceListPage}" />
        </Tab>
        <Tab Title="Files" Icon="folder.png">
            <ShellContent Route="files" ContentTemplate="{DataTemplate local:FileBrowserPage}" />
        </Tab>
        <Tab Title="Transfers" Icon="transfer.png">
            <ShellContent Route="transfers" ContentTemplate="{DataTemplate local:TransferPage}" />
        </Tab>
        <Tab Title="Settings" Icon="settings.png">
            <ShellContent Route="settings" ContentTemplate="{DataTemplate local:SettingsPage}" />
        </Tab>
    </TabBar>
</Shell>
