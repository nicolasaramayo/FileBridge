<ContentPage
    x:Class="FileBridge.UI.PairingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/2006/xaml"
    xmlns:local="clr-namespace:FileBridge.UI"
    xmlns:vm="clr-namespace:FileBridge.UI.ViewModels"
    xmlns:conv="clr-namespace:FileBridge.UI.Converters"
    Title="Pair Device">

    <ContentPage.Resources>
        <conv:BoolToInverseConverter x:Key="InverseBoolConverter" />
        <conv:NotNullOrEmptyConverter x:Key="NotNullOrEmptyConverter" />
        <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

            <!-- Status Message -->
            <Label 
                Text="{Binding StatusMessage}" 
                FontSize="16" 
                HorizontalTextAlignment="Center" />

            <!-- Pairing Code Display -->
            <Frame 
                IsVisible="{Binding PairingCodeDisplay, Converter={StaticResource NotNullOrEmptyConverter}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                CornerRadius="12"
                Padding="24"
                HorizontalOptions="Center">
                <Label 
                    Text="{Binding PairingCodeDisplay}" 
                    FontSize="48" 
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center" />
            </Frame>

            <!-- Device Name -->
            <Label 
                Text="{Binding DeviceName}" 
                FontSize="14"
                Opacity="0.7"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding DeviceName, Converter={StaticResource NotNullOrEmptyConverter}}" />

            <!-- Generate Code Button -->
            <Button 
                Text="Generate Pairing Code"
                Command="{Binding GenerateCodeCommand}"
                IsEnabled="{Binding IsGeneratingCode, Converter={StaticResource InverseBoolConverter}}"
                Margin="0,10,0,0" />

            <!-- Success State -->
            <Frame 
                IsVisible="{Binding IsPaired}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                CornerRadius="12"
                Padding="20"
                HorizontalOptions="Center">
                <Label 
                    Text="✓ Pairing Successful!" 
                    FontSize="18" 
                    FontAttributes="Bold"
                    TextColor="White" />
            </Frame>

            <!-- Back Button -->
            <Button 
                Text="← Back"
                Command="{Binding GoBackCommand}"
                Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
