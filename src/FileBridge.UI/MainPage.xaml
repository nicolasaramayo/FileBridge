<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="FileBridge.UI.MainPage"
    xmlns:vm="clr-namespace:FileBridge.UI.ViewModels">
    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>
    
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="FileBridge" FontSize="32" HorizontalOptions="Center" />
        <Label Text="Transfer files between your devices" HorizontalOptions="Center" />
        
        <Button Text="📱 Devices" Command="{Binding OpenDevicesCommand}" />
        <Button Text="📁 Transfers" Command="{Binding OpenTransfersCommand}" />
        <Button Text="⚙️ Settings" Command="{Binding OpenSettingsCommand}" />
    </VerticalStackLayout>
</ContentPage>
