<ContentPage
    x:Class="FileBridge.UI.DeviceListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FileBridge.UI"
    xmlns:vm="clr-namespace:FileBridge.UI.ViewModels"
    xmlns:conv="clr-namespace:FileBridge.UI.Converters"
    Title="Devices">

    <ContentPage.Resources>
        <conv:BoolToInverseConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="16,12" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
            <Label Text="Nearby Devices" FontSize="20" FontAttributes="Bold" TextColor="White" />
            <Label Text="Select a device to send or receive files" FontSize="12" TextColor="White" Opacity="0.8" />
        </StackLayout>

        <!-- Device List -->
        <ListView x:Name="devicesList"
                  Grid.Row="1" 
                  ItemsSource="{Binding Devices}"
                  HasUnevenRows="True"
                  RefreshCommand="{Binding RefreshCommand}"
                  IsPullToRefreshEnabled="True"
                  IsRefreshing="{Binding IsRefreshing}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame Margin="12,6" Padding="12" CornerRadius="10" 
                               BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    NumberOfTapsRequired="1"
                                    Tapped="OnDeviceTapped" />
                            </Frame.GestureRecognizers>
                            <StackLayout Orientation="Horizontal">
                                <!-- Device Icon -->
                                <Label Text="📱" FontSize="32" VerticalOptions="Center" WidthRequest="48" />
                                
                                <!-- Device Info -->
                                <StackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding IpAddress}" FontSize="12" Opacity="0.7" />
                                </StackLayout>
                                
                                <!-- Action Button -->
                                <Button Text="→" 
                                        WidthRequest="44" HeightRequest="44"
                                        Clicked="OnDeviceActionClicked" />
                            </StackLayout>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackLayout Grid.Row="1" 
                     HorizontalOptions="Center" 
                     VerticalOptions="Center"
                     Spacing="12"
                     IsVisible="{Binding Devices.Count, Converter={StaticResource InverseBoolConverter}, FallbackValue=False}">
            <Label Text="📡" FontSize="64" HorizontalOptions="Center" />
            <Label Text="No devices found" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Make sure the other device is connected to the same network" 
                   FontSize="14" Opacity="0.7" HorizontalTextAlignment="Center" />
            <Button Text="🔄 Refresh" Command="{Binding RefreshCommand}" Margin="0,10,0,0" />
        </StackLayout>

        <!-- Loading overlay -->
        <ActivityIndicator Grid.Row="1" 
                           IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />

        <!-- Refresh FAB -->
        <Button Grid.Row="1"
                Text="🔄"
                FontSize="20"
                Command="{Binding RefreshCommand}"
                WidthRequest="56" HeightRequest="56"
                CornerRadius="28"
                HorizontalOptions="End" 
                VerticalOptions="End"
                Margin="16"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </Grid>
</ContentPage>
